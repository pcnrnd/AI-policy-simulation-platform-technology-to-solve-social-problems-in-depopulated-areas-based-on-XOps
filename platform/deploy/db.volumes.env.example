# DB Compose(project=population-db)가 이어 붙일 기존 실볼륨·이미지 — 비밀값 없음.
# 서버에서 deploy/db.volumes.env로 복사해 쓴다. 키를 비우거나 지우면 Compose가 기동을 거부한다.
# 아래 값은 dts 운영 서버 실측(2026-10-26). 다른 서버는 docker inspect로 확인한 이름으로 바꾼다.
# 없는 볼륨 이름을 넣으면 실패한다(external) — 새 볼륨을 만들어 맞추지 말 것.

POP_DB_PG_VOLUME=platform_pg-data
POP_DB_TIMESCALE_VOLUME=platform_timescale-data
POP_DB_MONGO_VOLUME=platform_mongo-data
# mongo 이미지 VOLUME(/data/configdb)이 만든 익명 볼륨 — 이름이 해시라 서버마다 다르다.
POP_DB_MONGO_CONFIG_VOLUME=68136c6c6e8217d55c76daed8b0af76ff1fa2be6048e538cb0b2750cf1982224

# compose.db.ec2.yaml 전용 — 기존 컨테이너와 같은 이미지(RepoDigest). pull_policy=never라 서버에 없으면 실패한다.
POP_DB_PG_IMAGE=postgis/postgis@sha256:44126d872ac91993766c341e369c539e8196614321765d36a6f1bab0419a5fa5
POP_DB_TIMESCALE_IMAGE=timescale/timescaledb@sha256:75d58b53f3337a6babd3a1cce5e503f2300bdede62dd7d743651deb1a95b6d76
POP_DB_MONGO_IMAGE=mongo@sha256:9854f7139445d766a9523571d6f047530c45547460ffcf8259eb2bf4264632ca
