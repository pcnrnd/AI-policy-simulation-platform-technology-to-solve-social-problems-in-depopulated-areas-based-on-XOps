# EC2 로그인 게이트 환경변수 목록. platform/deploy/.env로 복사해 값을 채운다(.env는 커밋하지 않는다).
# 사용: docker compose --env-file platform/deploy/.env -f platform/compose.xops.yaml -f platform/compose.ec2.yaml ...

# 공개 도메인(포트·경로 없이). 로그인 포털은 https://<SITE_DOMAIN>/authelia/ 에 뜬다.
SITE_DOMAIN=
# 운영: Let's Encrypt 인증서 알림을 받을 이메일. 로컬 검증: internal (Caddy 자체 CA)
CADDY_TLS=
# 호스트 포트. 운영은 비워 둔다(기본 80/443). 로컬에서 80/443이 점유됐을 때만 지정한다.
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# xops-service 토큰 서명키(HS256). openssl rand -hex 32
XOPS_JWT_SECRET=
# pg·timescale·mongo 공용 비밀번호. DSN(URL)에 그대로 들어가므로 영숫자만 쓴다. openssl rand -hex 24
# 볼륨을 처음 만들 때만 적용된다 — 기존 볼륨이 있으면 바꿔도 반영되지 않는다.
DB_PASSWORD=

# Authelia 비밀값은 이 파일이 아니라 platform/deploy/authelia/secrets/ 의 파일로 둔다(런북 참고).
